[Unit]
Description=sidekeys (xremap-powered mouse side-button remapping)
Documentation=https://github.com/lilyrosary-eng/sidekeys
After=default.target
# 与 keyd 互斥：两者都靠 EVIOCGRAB 独占同一只鼠标，而 grab 撞上 EBUSY 的一方
# 不报错退出、只是不接管设备（xremap src/device.rs），于是服务照样 running、侧键静默失灵。
# 交给 systemd 保证事务里同时只有一个，而不是只靠脚本里那些 disable --now。
Conflicts=keyd.service
Before=keyd.service

[Service]
# 实际入口是 wrapper：systemd 会把展开后的变量按空白拆成多个参数，而设备名里几乎总带空格，
# 所以必须由 shell 负责引号。见 contrib/sidekeys-run。
ExecStart=/usr/local/bin/sidekeys-run

# “+”前缀表示这一行始终以 root 运行（User= 只作用于主进程）。
# Ubuntu 上 logind 的 uaccess 会把 /dev/uinput 的 ACL group:: 降成 ---，
# 即使节点属组是 input 也拿不到权限，因此每次启动补一条组 ACL。
ExecStartPre=+/usr/bin/setfacl -m g:input:rw /dev/uinput

Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
User=xremap
Group=xremap
SupplementaryGroups=input
RuntimeDirectory=xremap
RuntimeDirectoryMode=0755
Environment=RUST_LOG=warn
MemoryHigh=8M
MemoryMax=16M
IPAddressDeny=any

[Install]
WantedBy=default.target
