#!/usr/bin/env python3
"""input-probe —— 判断按键到底进了哪一层：evdev（有 keycode）还是只有 hidraw（厂商原始报告）。

修掉了上一版的致命 bug：格式化事件时用了不存在的 ecodes.event_type，
导致任何设备一产生事件就把读取线程炸掉、事件被丢弃。现在：
  · 查找表用 e.EV / e.KEY，全部包 try，绝不让线程死；
  · hidraw 每条报告带时间戳和 hex，方便和「按了第几个键」对齐；
  · 表头打印每个 hidraw 的 vid:pid + USB 接口号。

用法：
    pkexec input-probe 30
"""

import datetime
import glob
import os
import re
import sys
import threading
import time

import evdev
import evdev.ecodes as e

LOG = "/tmp/input-probe.log"
MAX_REPORTS = 120


def key_name(code):
    try:
        v = e.KEY[code]
        return v[0] if isinstance(v, tuple) else str(v)
    except Exception:
        return "0x%x" % code


def type_name(t):
    try:
        v = e.EV[t]
        return v[0] if isinstance(v, tuple) else str(v)
    except Exception:
        return "0x%x" % t


def hidraw_info(path):
    node = os.path.basename(path)
    dev = f"/sys/class/hidraw/{node}/device"
    vidpid, iface, name = "?", "?", ""
    try:
        real = os.path.realpath(dev)
        m = re.search(r"([0-9a-fA-F]{4}):([0-9a-fA-F]{4})\.([0-9a-f]{4})", real)
        if m:
            vidpid = f"{m.group(1)}:{m.group(2)}"
            iface = m.group(3)
        m2 = re.search(r"usb-[^/]+/(\d+-\d+(?:\.\d+)?)", real)
        if m2:
            iface = m2.group(1)
    except OSError:
        pass
    try:
        with open(f"{dev}/../name", encoding="utf-8", errors="replace") as fh:
            name = fh.read().strip()
    except OSError:
        pass
    return vidpid, iface, name


def main():
    flags = [a for a in sys.argv[1:] if a.startswith("--")]
    positional = [a for a in sys.argv[1:] if not a.startswith("--")]
    keys_only = "--keys" in flags
    seconds = float(positional[0]) if positional else 45.0
    preroll = 5.0
    devices = []
    for p in evdev.list_devices():
        try:
            devices.append(evdev.InputDevice(p))
        except OSError:
            pass
    hidraws = sorted(glob.glob("/dev/hidraw*"))

    events = []
    reports = []
    hid_bytes = {p: 0 for p in hidraws}
    lock = threading.Lock()
    stop_at = time.monotonic() + seconds

    print(f"窗口期 {seconds:.0f}s｜evdev 设备 {len(devices)} 个｜hidraw 节点 {len(hidraws)} 个" + ("｜只记按键" if keys_only else ""))
    for p in hidraws:
        vidpid, iface, name = hidraw_info(p)
        print(f"    {p}  {vidpid}  iface {iface}  {name}")
    print(f"\n{preroll:.0f} 秒后开始，请把手放到鼠标上…", flush=True)
    for i in range(int(preroll), 0, -1):
        print(f"    {i}…", flush=True)
        time.sleep(1)
    stop_at = time.monotonic() + seconds
    print(f"\n开始：窗口期 {seconds:.0f} 秒。按你在窗口期前读到的那张表执行（这里不重复规定动作，避免两套指令互相覆盖），Ctrl-C 可提前结束。\n", flush=True)
    print("时间列 = 相对窗口内第一条事件的毫秒差（内核时间戳）；前缀 ~ 表示该事件没有内核时间戳，退回读取时刻。\n", flush=True)

    origin = [None]

    def event_stamp(ev):
        try:
            ts = ev.timestamp()
        except Exception:
            ts = None
        if ts is None:
            return "~" + datetime.datetime.now().strftime("%H:%M:%S.%f")[:-3]
        with lock:
            if origin[0] is None:
                origin[0] = ts
            rel = (ts - origin[0]) * 1000.0
        return "+%8.1fms" % rel

    def read_evdev(dev):
        while time.monotonic() < stop_at:
            try:
                for ev in dev.read():
                    if keys_only and ev.type != 1:
                        continue
                    # 必须用事件自带的内核时间戳：dev.read() 一次会排空一批事件，
                    # 如果用读取时刻，整批都会被记成同一毫秒，长按/到点触发这类
                    # 依赖间隔判断的结论就完全没法做。
                    stamp = event_stamp(ev)
                    line = "%s evdev %-30s %s code=%-4s %-20s value=%s" % (
                        stamp,
                        dev.name[:30], type_name(ev.type), ev.code,
                        key_name(ev.code) if ev.type == 1 else "", ev.value,
                    )
                    with lock:
                        events.append(line)
            except IOError:
                time.sleep(0.01)
            except Exception as exc:
                with lock:
                    events.append(f"!! {dev.path} 记录异常: {type(exc).__name__}: {exc}")
                return

    def read_hidraw(path):
        vidpid, iface, name = hidraw_info(path)
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as exc:
            with lock:
                reports.append(f"!! {path} 打不开: {exc}")
            return
        while time.monotonic() < stop_at:
            try:
                data = os.read(fd, 128)
                if data:
                    stamp = "~" + datetime.datetime.now().strftime("%H:%M:%S.%f")[:-3]
                    with lock:
                        hid_bytes[path] += len(data)
                        if len(reports) < MAX_REPORTS:
                            reports.append(
                                "%s hidraw %-10s %s/%s %-16s %s"
                                % (stamp, os.path.basename(path), vidpid, iface, name[:16], data.hex(" "))
                            )
            except BlockingIOError:
                time.sleep(0.004)
            except OSError:
                time.sleep(0.01)
        os.close(fd)

    threads = [threading.Thread(target=read_evdev, args=(d,), daemon=True) for d in devices]
    threads += [threading.Thread(target=read_hidraw, args=(p,), daemon=True) for p in hidraws]
    for t in threads:
        t.start()
    try:
        last_beat = 0.0
        while time.monotonic() < stop_at:
            time.sleep(0.2)
            now = time.monotonic()
            if now - last_beat >= 1.0:
                last_beat = now
                with lock:
                    nev, nbytes = len(events), sum(hid_bytes.values())
                print("   …剩余 %4.0fs｜evdev %3d 条｜hidraw %5d 字节   (没反应说明该键不发 HID)"
                      % (stop_at - now, nev, nbytes), flush=True)
    except KeyboardInterrupt:
        print("\n（被 Ctrl-C 提前中断，窗口期未满，结果可能不完整）", flush=True)
    time.sleep(0.3)
    print("窗口期结束。", flush=True)

    lines = [f"=== input-probe {seconds:.0f}s ===", ""]
    lines.append(f"—— evdev 事件 {len(events)} 条 ——")
    lines += events[:150] or ["(没有任何 evdev 事件：说明这些键没被内核映射成 keycode)"]
    lines.append("")
    lines.append(f"—— hidraw 原始报告（{sum(1 for v in hid_bytes.values() if v)} 个节点有数据）——")
    for p, n in hid_bytes.items():
        lines.append(f"[{os.path.basename(p)}] 共 {n} 字节")
    lines.append("")
    lines += reports[:MAX_REPORTS]
    body = "\n".join(lines) + "\n"
    # 上一个窗口期可能以 root 跑过，日志就成了 root 属主；这种情况下必须照样把结果
    # 吐到终端，而不是收集完数据却在最后一步崩掉。
    try:
        with open(LOG, "w", encoding="utf-8") as fh:
            fh.write(body)
        location = LOG
    except OSError as exc:
        fallback = f"/tmp/input-probe-{os.getuid()}.log"
        try:
            with open(fallback, "w", encoding="utf-8") as fh:
                fh.write(body)
            location = fallback
            print(f"[写 {LOG} 失败（{exc.strerror}），已改写 {fallback}]\n")
        except OSError as exc2:
            location = None
            print(f"[写日志失败：{exc2}，只在终端输出]\n")
    print(body[:5000])
    if location:
        print(f"[完整结果在 {location}]")


if __name__ == "__main__":
    main()
