#!/usr/bin/env python3
"""omen-capture —— 有界窗口期内记录按键，专治“干扰多”。

默认只记 EV_KEY 的 press(value=1)、按 (设备,键码) 去重并计数，
鼠标 BTN_* 一律忽略，所以按六个宏键只会得到六行左右的结果。

用法：
    pkexec omen-capture 30                       # 30 秒窗口期
    pkexec omen-capture 30 --only OMEN --only WMI  # 只监听名字含这些关键字的设备
    pkexec omen-capture 30 --exclude "Video Bus"    # 排除爱乱发事件的设备
"""

import datetime
import sys
import threading
import time

import evdev
import evdev.ecodes as e

LOG = "/tmp/omen-capture.log"
DEFAULT_EXCLUDE = ["Video Bus"]


def args():
    secs = 30.0
    only, exclude = [], list(DEFAULT_EXCLUDE)
    rest = [a for a in sys.argv[1:]]
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--only":
            only.append(rest[i + 1]); i += 2
        elif a == "--exclude":
            exclude.append(rest[i + 1]); i += 2
        else:
            secs = float(a); i += 1
    return secs, only, exclude


def code_name(code):
    try:
        v = e.KEY[code]
    except Exception:
        return "0x%x" % code
    return v[0] if isinstance(v, tuple) else str(v)


def main():
    seconds, only, exclude = args()
    picked = []
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        if any(x in dev.name for x in exclude):
            continue
        if only and not any(k.lower() in dev.name.lower() for k in only):
            continue
        picked.append(dev)
    if not picked:
        print("没有可读且匹配的设备：请用 root 运行，且别把 --only 写得太窄", file=sys.stderr)
        return 3

    print(f"窗口期 {seconds:.0f}s，监听 {len(picked)} 个设备：")
    for d in picked:
        print("   ", d.path, d.name)
    print("请依次按下目标键，每个间隔约 1 秒（Ctrl-C 可提前结束）\n", flush=True)

    hits = {}
    lock = threading.Lock()
    stop_at = time.monotonic() + seconds

    def loop(dev):
        while time.monotonic() < stop_at:
            try:
                for ev in dev.read():
                    if ev.type == 1 and ev.value == 1:  # EV_KEY press
                        with lock:
                            key = (dev.name, ev.code)
                            hits.setdefault(key, [0, datetime.datetime.now()])
                            hits[key][0] += 1
            except IOError:
                time.sleep(0.01)

    threads = [threading.Thread(target=loop, args=(d,), daemon=True) for d in picked]
    for t in threads:
        t.start()
    try:
        while any(t.is_alive() for t in threads):
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass

    lines = []
    for (dname, code), (count, first) in sorted(hits.items(), key=lambda kv: kv[1][1]):
        lines.append("%s  %-34s %-18s code=%-4s x%d" % (
            first.strftime("%H:%M:%S"), dname[:34], code_name(code), code, count))
    body = "=== omen-capture %ss ===\n%s\n" % (seconds, "\n".join(lines) or "(窗口期内没有任何按键)")
    open(LOG, "w", encoding="utf-8").write(body)
    print(body)
    print(f"[已写入 {LOG}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
